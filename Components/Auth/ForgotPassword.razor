@page "/forgot-password"
@inject UserManager<AppUser> UserManager
@inject ILogger<ForgotPassword> Logger

<h3>Forgot password</h3>
<EditForm Model="model" OnValidSubmit="Handle">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="model.Email" />
    <button type="submit">Send reset link</button>
</EditForm>

@code {
    ForgotModel model = new();

    record ForgotModel { [Required, EmailAddress] public string? Email { get; set; } }

    async Task Handle()
    {
        if(model.Email is null) //TODO: Add error message
            return;

        var user = await UserManager.FindByEmailAsync(model.Email);

        if (user == null) //TODO: Add error message
            return;

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var url = $"/reset-password?email={Uri.EscapeDataString(model.Email!)}&code={Uri.EscapeDataString(token)}";
        // TODO
        // Implement IEmailSender.
        // Send url via email
    }
}