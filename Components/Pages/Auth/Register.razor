@page "/register"
@rendermode InteractiveServer
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IEmailSender<AppUser> EmailSender
@inject NavigationManager Nav
@inject ILogger<Register> Logger

<h3>Register</h3>
<EditForm Model="model" OnValidSubmit="HandleRegister" OnInvalidSubmit="HandleInvalid" FormName="Register">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="model.Email" class="form-control" placeholder="Email" />
    <InputText @bind-Value="model.Password" type="password" class="form-control" placeholder="Password" />
    <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@code {
    [Parameter]
    public string? returnUrl { get; set; }
    RegisterModel model = new();

    record RegisterModel
    {
        [Required, EmailAddress] public string? Email { get; set; }
        [Required, MinLength(6)] public string? Password { get; set; }
        [Compare(nameof(Password))] public string? ConfirmPassword { get; set; }
    }

    async Task HandleRegister()
    {
        if(model.Email is null || model.Password is null || model.ConfirmPassword is null) //TODO: Add error message
            return;

        var user = new AppUser { UserName = model.Email, Email = model.Email };
        var result = await UserManager.CreateAsync(user, model.Password);

        if (!result.Succeeded) //TODO: Add error message
            return;
        
        string token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        string userId = user.Id;
        Dictionary<string,string?> dto = new Dictionary<string, string?>
        {
            { "userId" , userId },
            { "token", token },
            { "returnUrl", returnUrl }
        };
        string json = JsonSerializer.Serialize(dto);
        string data = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(json));
        var confirmLink = Nav.ToAbsoluteUri($"/confirmEmail/{data}").AbsoluteUri;
        if(confirmLink is not null)
            await EmailSender.SendConfirmationLinkAsync(user,user.Email,confirmLink);
        else
            Logger.LogError("Unable to generate confirmation link!");

        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl ?? "/")}");
    }

    async Task HandleInvalid(EditContext context)
    {
        Logger.LogWarning($"Invalid submit: {model.Email} {context.Validate()}");
    }
}