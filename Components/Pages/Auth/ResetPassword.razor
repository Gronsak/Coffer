@page "/reset-password"
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<h3>Reset password</h3>
<EditForm Model="model" OnValidSubmit="Handle">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="model.Password" type="password" />
    <InputText @bind-Value="model.ConfirmPassword" type="password" />
    <button type="submit">Reset</button>
</EditForm>

@code {
    [Parameter] public string? email { get; set; }
    [Parameter] public string? code { get; set; }

    ResetModel model = new();

    record ResetModel
    {
        [Required] public string? Password { get; set; } 
        [Compare(nameof(Password))] public string? ConfirmPassword { get; set; } 
    }

    async Task Handle()
    {
        if (email == null || code == null || model.Password is null) //TODO: Add error message
            return;

        var user = await UserManager.FindByEmailAsync(email);
        if (user == null)
        {
            //TODO: Add success message
            return; 
        }

        var result = await UserManager.ResetPasswordAsync(user, code, model.Password);
        if (result.Succeeded) {
            Nav.NavigateTo("/login");
        }
        else 
        { 
            //TODO: Add error message
        }
    }
}